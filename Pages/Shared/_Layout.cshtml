<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PDF Tools</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-page="/Index">
                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-3"></i>
                    <span>PDF Tools</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var currentPage = ViewContext.RouteData.Values["page"] as string;
                    }
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">Accueil</a>
                        </li>
                        @foreach (var category in ToolCatalog.Categories)
                        {
                            var categoryActive = category.Tools.Any(t => t.Page == currentPage);
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(categoryActive ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @category.Name
                                </a>
                                <ul class="dropdown-menu">
                                    @foreach (var tool in category.Tools)
                                    {
                                        <li>
                                            <a class="dropdown-item @(tool.Page == currentPage ? "active" : "")" asp-page="@tool.Page">
                                                <i class="bi @tool.Icon me-2"></i>@tool.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 container">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted py-3 mt-5 bg-white">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - PDF Tools — Traitement sécurisé de documents PDF
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>