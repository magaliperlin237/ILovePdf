@page
@model ILovePDF.Pages.PdfRedactModel
@{
    ViewData["Title"] = "Caviarder un PDF";
}

<div class="text-center my-4">
    <h1 class="display-5 fw-bold text-dark">Caviarder un PDF</h1>
    <p class="lead text-secondary">Masquez définitivement des informations sensibles : le texte caviardé est supprimé du fichier.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div id="redact-drop-zone" class="drop-zone p-5 text-center border-2 border-dashed rounded-4 bg-white shadow-sm mb-4">
            <i class="bi bi-eraser-fill text-danger display-1"></i>
            <h4 class="mt-3">Glissez-déposez votre PDF ici</h4>
            <p class="text-muted small mb-3">Un seul fichier · @Model.MaxFileSizeMb Mo maximum. Le traitement des zones se fait dans votre navigateur.</p>
            <input type="file" id="redact-file-input" accept="application/pdf,.pdf" class="d-none" />
            <button type="button" class="btn btn-danger btn-lg px-4" onclick="document.getElementById('redact-file-input').click()">
                <i class="bi bi-folder-plus me-2"></i>Choisir un PDF
            </button>
        </div>

        <div id="redact-alert" class="alert alert-danger d-none shadow-sm" role="alert"></div>

        <div id="redact-editor" class="d-none">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <div class="fw-bold text-truncate" id="redact-file-name"></div>
                            <small class="text-muted" id="redact-file-meta"></small>
                        </div>
                        <button type="button" id="redact-change-file" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-repeat me-1"></i>Changer de fichier
                        </button>
                    </div>

                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-cursor me-1"></i>
                        <strong>Dessinez des rectangles</strong> sur les pages pour choisir les zones à masquer, ou utilisez la recherche automatique ci-dessous.
                    </div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label for="redact-terms" class="form-label fw-semibold">
                                <i class="bi bi-search me-1"></i>Mots ou expressions à caviarder
                            </label>
                            <textarea id="redact-terms" class="form-control" rows="3"
                                      placeholder="Un mot ou une expression par ligne&#10;Ex. Jean Dupont"></textarea>
                        </div>
                        <div class="col-md-5">
                            <div class="form-label fw-semibold">Détection automatique</div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="preset-email">
                                <label class="form-check-label" for="preset-email">Adresses e-mail</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="preset-phone">
                                <label class="form-check-label" for="preset-phone">Numéros de téléphone (FR)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="preset-iban">
                                <label class="form-check-label" for="preset-iban">IBAN</label>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap align-items-center gap-3">
                            <button type="button" id="redact-search-btn" class="btn btn-outline-danger">
                                <i class="bi bi-magic me-1"></i>Rechercher et marquer
                            </button>
                            <span id="redact-search-result" class="small text-muted"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <label for="redact-quality" class="form-label fw-bold mb-1">Qualité des pages caviardées</label>
                            <select id="redact-quality" class="form-select">
                                <option value="1.5">Standard — fichier léger</option>
                                <option value="2" selected>Bonne — recommandé</option>
                                <option value="3">Très haute — fichier plus lourd</option>
                            </select>
                        </div>
                        <div class="col-md-8 small text-muted">
                            Les pages contenant des zones caviardées sont converties en image (le texte n'y est plus sélectionnable).
                            Les autres pages restent inchangées. Les métadonnées du document d'origine ne sont pas conservées.
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h5 class="fw-bold m-0"><span id="redact-count">0</span> zone(s) à caviarder</h5>
                <button type="button" id="redact-clear-btn" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-trash me-1"></i>Tout effacer
                </button>
            </div>

            <div id="redact-pages" class="mb-4"></div>

            <div class="d-grid gap-2 mb-4">
                <button id="redact-apply-btn" type="button" class="btn btn-danger btn-lg py-3 fw-bold" disabled>
                    <i class="bi bi-eraser me-2"></i>Caviarder et télécharger
                </button>
            </div>
        </div>

        <div id="redact-loading" class="d-none text-center p-5 bg-white rounded-4 shadow-sm">
            <div class="spinner-border text-danger mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <h4 class="fw-bold" id="redact-loading-title">Caviardage en cours...</h4>
            <p class="text-muted mb-0" id="redact-loading-text">Veuillez patienter.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.redactConfig = { maxFileSizeMb: @Model.MaxFileSizeMb };
    </script>
    <script src="~/js/pdf-redact.js" asp-append-version="true"></script>
}
