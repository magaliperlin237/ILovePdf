@page
@model PdfMergeModel
@{
    ViewData["Title"] = "Fusionner des fichiers PDF";
}

<div class="text-center my-4">
    <h1 class="display-5 fw-bold text-dark">Fusionner des PDF</h1>
    <p class="lead text-secondary">Combinez plusieurs fichiers PDF en un seul document.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Zone de Drop -->
        <div id="drop-zone" class="drop-zone p-5 text-center border-2 border-dashed rounded-4 bg-white shadow-sm mb-4">
            <i class="bi bi-cloud-arrow-up text-danger display-1"></i>
            <h4 class="mt-3">Glissez-déposez vos fichiers PDF ici</h4>
            <p class="text-muted small mb-3">Taille maximale par fichier : @Model.MaxFileSizeMb Mo. Maximum @Model.MaxFiles fichiers.</p>
            <input type="file" id="file-input" multiple accept="application/pdf" class="d-none" />
            <button type="button" class="btn btn-danger btn-lg px-4" onclick="document.getElementById('file-input').click()">
                <i class="bi bi-folder-plus me-2"></i>Choisir des fichiers
            </button>
        </div>

        <!-- Alerte d'erreur -->
        <div id="alert-message" class="alert alert-danger d-none shadow-sm" role="alert"></div>

        <!-- Liste des fichiers sélectionné -->
        <div id="file-list-container" class="d-none">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0">Ordre d'assemblage</h5>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('file-input').click()">
                    <i class="bi bi-plus-lg me-1"></i>Ajouter d'autres fichiers
                </button>
            </div>

            <div id="file-list" class="list-group mb-4 shadow-sm"></div>

            <div class="d-grid gap-2">
                <button id="merge-btn" type="button" class="btn btn-danger btn-lg py-3 fw-bold">
                    <i class="bi bi-file-earmark-zip me-2"></i>Fusionner les PDF
                </button>
            </div>
        </div>

        <!-- Overlay de Chargement -->
        <div id="loading-overlay" class="d-none text-center p-5 bg-white rounded-4 shadow-sm">
            <div class="spinner-border text-danger mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <h4 class="fw-bold">Fusion de vos PDF en cours...</h4>
            <p class="text-muted mb-0">Veuillez patienter pendant la génération du fichier final.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.pdfAppConfig = {
            maxFileSizeMb: @Model.MaxFileSizeMb,
            maxFiles: @Model.MaxFiles
        };
    </script>
    <script src="~/js/pdf.js" asp-append-version="true"></script>
}