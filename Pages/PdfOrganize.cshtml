@page
@model ILovePDF.Pages.PdfOrganizeModel
@{
    ViewData["Title"] = "Organiser les pages";
}

<div class="text-center my-4">
    <h1 class="display-5 fw-bold text-dark">Organiser les pages</h1>
    <p class="lead text-secondary">Glissez les pages pour les réordonner, pivotez-les ou supprimez celles dont vous n’avez pas besoin.</p>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <form id="organizeForm" class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div id="dropZone" class="drop-zone border-2 border-dashed rounded-4 p-4 text-center mb-4">
                    <i class="bi bi-file-earmark-pdf text-danger fs-1"></i>
                    <h6 class="mt-2 mb-1">Glissez votre PDF ici</h6>
                    <p class="text-muted small mb-2">ou cliquez pour sélectionner un fichier</p>
                    <input id="pdfFile" type="file" accept="application/pdf,.pdf" hidden />
                    <button type="button" class="btn btn-outline-danger btn-sm" id="chooseFile">Choisir un PDF</button>
                    <div id="fileInfo" class="mt-2 small fw-semibold d-none"></div>
                </div>

                <div class="fw-semibold mb-2">Actions rapides</div>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="rotateAll"><i class="bi bi-arrow-clockwise me-1"></i>Pivoter toutes les pages (90°)</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="reverseOrder"><i class="bi bi-arrow-down-up me-1"></i>Inverser l’ordre</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="resetAll"><i class="bi bi-arrow-counterclockwise me-1"></i>Tout réinitialiser</button>
                </div>
                <div class="form-text mt-2">Astuce : survolez une page pour la pivoter ou la supprimer.</div>

                <div id="alert" class="alert d-none mt-4 mb-0"></div>

                <button id="submitBtn" type="submit" class="btn btn-danger btn-lg w-100 mt-4" disabled>
                    <i class="bi bi-download me-2"></i>Enregistrer le PDF
                </button>
            </div>
        </form>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold m-0"><i class="bi bi-grid-3x3-gap me-2"></i>Pages</h5>
                    <span id="pageCountBadge" class="badge text-bg-secondary d-none"></span>
                </div>
                <div id="gridPlaceholder" class="wm-preview-placeholder text-muted text-center">
                    <i class="bi bi-file-earmark-pdf display-4"></i>
                    <p class="mt-2 mb-0">Chargez un PDF pour voir ses pages.</p>
                </div>
                <div id="pageGrid" class="ext-grid d-none"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pdf-organize.js" asp-append-version="true"></script>
}
