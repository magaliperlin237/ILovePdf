@page
@model ILovePDF.Pages.PdfToImagesModel
@{
    ViewData["Title"] = "PDF vers images";
}

<div class="text-center my-4">
    <h1 class="display-5 fw-bold text-dark">PDF → Images</h1>
    <p class="lead text-secondary">Exportez les pages de votre PDF en PNG ou JPEG. La conversion se fait directement dans votre navigateur : le fichier n’est pas envoyé au serveur.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <form id="toImagesForm" class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div id="dropZone" class="drop-zone border-2 border-dashed rounded-4 p-4 text-center mb-4">
                    <i class="bi bi-file-earmark-pdf text-danger fs-1"></i>
                    <h6 class="mt-2 mb-1">Glissez votre PDF ici</h6>
                    <p class="text-muted small mb-2">ou cliquez pour sélectionner un fichier</p>
                    <input id="pdfFile" type="file" accept="application/pdf,.pdf" hidden />
                    <button type="button" class="btn btn-outline-danger btn-sm" id="chooseFile">Choisir un PDF</button>
                    <div id="fileInfo" class="mt-2 small fw-semibold d-none"></div>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="form-label fw-semibold">Format</div>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="imgFormat" id="fmtPng" value="png" checked>
                            <label class="btn btn-outline-danger" for="fmtPng">PNG</label>
                            <input type="radio" class="btn-check" name="imgFormat" id="fmtJpg" value="jpg">
                            <label class="btn btn-outline-danger" for="fmtJpg">JPEG</label>
                        </div>
                        <div class="form-text">PNG : sans perte. JPEG : fichiers plus légers.</div>
                    </div>
                    <div class="col-sm-6">
                        <label for="dpi" class="form-label fw-semibold">Résolution</label>
                        <select id="dpi" class="form-select">
                            <option value="72">72 dpi (écran, léger)</option>
                            <option value="110">110 dpi</option>
                            <option value="150" selected>150 dpi (recommandé)</option>
                            <option value="200">200 dpi</option>
                            <option value="300">300 dpi (impression)</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <div class="form-label fw-semibold">Pages à exporter</div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="pagesMode" id="pagesAll" value="all" checked />
                            <label class="form-check-label" for="pagesAll">Toutes les pages</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="pagesMode" id="pagesCustom" value="custom" />
                            <label class="form-check-label" for="pagesCustom">Certaines pages</label>
                        </div>
                        <input id="pagesInput" class="form-control mt-2 d-none" placeholder="ex. 1,3,5-8" autocomplete="off" />
                        <div id="pagesHelp" class="form-text d-none"></div>
                    </div>
                </div>

                <div id="progressWrap" class="mt-4 d-none">
                    <div class="progress" role="progressbar" aria-label="Progression">
                        <div id="progressBar" class="progress-bar bg-danger" style="width: 0%"></div>
                    </div>
                    <div id="progressText" class="form-text"></div>
                </div>

                <div id="alert" class="alert d-none mt-4 mb-0"></div>

                <button id="submitBtn" type="submit" class="btn btn-danger btn-lg w-100 mt-4" disabled>
                    <i class="bi bi-download me-2"></i>Convertir et télécharger
                </button>
                <div class="form-text text-center mt-2">Plusieurs pages : vous recevrez une archive ZIP.</div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="~/js/pdf-to-images.js" asp-append-version="true"></script>
}
